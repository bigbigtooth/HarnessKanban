# Harness看板（HarnessKanban）本地开发配置样例（复制为 backend/.env 使用）。
# 真实秘密只用部署环境变量管理，任何带 Key/密码的值都不得提交。

HARNESSTASK_ENV=development
LOG_LEVEL=INFO

# 数据库：本地开发使用固定绝对路径的 SQLite；两个 API 必须指向同一文件。
DB_ENGINE=sqlite
SQLITE_PATH=/Users/davidwu/GithubProject/HarnessTask/backend/var/harvesstask.sqlite3

# 分布式/正式环境改用 MySQL（同一写库，WebAPI、AgentAPI、Worker、Beat 共用）。
# DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=harvesstask
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_TEST_DATABASE=harvesstask_test

REDIS_URL=redis://127.0.0.1:6379/0

FILE_STORAGE_ROOT=/Users/davidwu/GithubProject/HarnessTask/backend/var/files

# 对象存储（阿里云 OSS）。OSS_ENABLED=false 时全部走本地私有存储。
# bucket 保持私有；文件访问通过签名 GET URL（有效期 OSS_URL_TTL_SECONDS，上限 7 天）。
OSS_ENABLED=false
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=harvesstask
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_URL_TTL_SECONDS=604800

# WebUI / WebAPI 访问密钥（至少 16 字符）。留空 = 不启用（本机回环开发默认）。
# 也可以写入 backend/secret/webui_access_key，并留空下面两项。
WEBUI_ACCESS_KEY=
WEBUI_ACCESS_KEY_FILE=
# 配置密钥后：浏览器打开 WebUI 会先要求登录；未携带密钥/密钥错误的 /api/web/v1 请求返回 403；
# curl 可用请求头 X-WebUI-Key 直接访问。

ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=http://127.0.0.1:7100,http://localhost:7100,http://127.0.0.1:7101,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000

# 固定执行超时映射（秒），必须五级为正且严格递增。
HARNESSTASK_TIMEOUT_L1=900
HARNESSTASK_TIMEOUT_L2=1800
HARNESSTASK_TIMEOUT_L3=7200
HARNESSTASK_TIMEOUT_L4=28800
HARNESSTASK_TIMEOUT_L5=86400

TIMEOUT_SCAN_INTERVAL_SECONDS=5
OUTBOX_SCAN_INTERVAL_SECONDS=5
OUTBOX_MAX_ATTEMPTS=5
CLAIM_LOCK_WAIT_SECONDS=5
CLAIM_COMPENSATION_LIMIT=100
CLAIM_MAX_REPLANS=3
DATABASE_RETRY_ATTEMPTS=3
SQLITE_BUSY_TIMEOUT_MS=5000

HEARTBEAT_INTERVAL_SECONDS=30
AGENT_OFFLINE_THRESHOLD_SECONDS=90
IDEMPOTENCY_RETENTION_DAYS=7

MAX_UPLOAD_BYTES=20971520
MAX_PROJECT_DOCUMENTS=100
MAX_TASK_REFERENCE_ATTACHMENTS=20
MAX_SUBMISSION_ARTIFACTS=10
TEMP_FILE_RETENTION_HOURS=24
DEFAULT_MAX_CONCURRENCY=1
